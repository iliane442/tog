[node name="Dalton" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1350.0, 1950.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String](["trm_drum_retour", "trm_drum_ours", "trm_drum_wapol", "trm_drum_pavillon"])
nom_affiche = "Dalton"
paroles = "Drum fut le royaume de la médecine, monsieur — jusqu'à ce que Wapol s'enfuie, revienne et se mette à manger le trésor du pays pièce par pièce. Il laisse même la Vigie racheter nos cartes de plaines. Aide-moi à tenir ce que le peuple n'a pas cessé d'espérer."

