[node name="Genzo" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1000.0, 1984.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String](["coco_panneaux", "coco_patrouille"])
nom_affiche = "Genzo"
paroles = "Je suis le shérif de Coco. Les panneaux indiquent les chemins que les hommes d'Arlong surveillent : le quai, la route et le mur du parc. Nojiko saura te dire ce que nous avons caché pour protéger le village."

