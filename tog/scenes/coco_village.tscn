[node name="Nojiko" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(832.0, 1600.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String](["trm_c4_bouteille", "trm_c4_arlong", "trm_c4_compteuse", "trm_c4_sel"])
nom_affiche = "Nojiko"
paroles = "Ma mère disait que la mer reprend toujours ce qu'on lui prend. Elle a laissé une bouteille scellée « pour le jour où quelqu'un viendrait avec l'Aiguille ». Le jardin est derrière la maison. Descend la racine de mandarine — et fais attention : même les cartes ont des créanciers, ici."

