[node name="CapitaineEsturgeon" parent="." instance=ExtResource("FerryLogue")]
position = Vector2(420.0, 2368.0)
paroles = "Derrière Coco commence le bout d'East Blue. Loguetown emboute les journaux de bord des candidats au départ, et un gris en profite pour racheter les témoignages. Si tu montes là-haut, montre-leur comment on s'en va."

[node name="CapitaineBarrique" parent="." instance=ExtResource("FerryBaratie")]
