hauteur_zone_clic = 120.0
chain_quetes = Array[String](["shells_panneaux", "shells_ravitaillement"])
nom_affiche = "Lise du marché"
paroles = "Bienvenue à Shells Town, marin. Les panneaux du quai, de la place et de l'esplanade te remettront le nord. Et si tu descends au port : trois caisses de ravitaillement attendent d'être embarquées — Morgan les réclame, mais je connais un meilleur usage."

