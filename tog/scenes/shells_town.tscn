[node name="Coby" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1792, 1830)
script = ExtResource("pnj")
largeur_zone_clic = 88.0
hauteur_zone_clic = 120.0
chain_quetes = Array[String](["shells_patrouille", "shells_morgan"])
nom_affiche = "Coby"
paroles = "Morgan s'est proclamé roi de cette base, et personne n'ose le contredire. Sa patrouille rôde entre la rue et l'esplanade. Repousse-la d'abord. Ensuite... il faudra bien que quelqu'un lui rende son galon. Ça ne sera pas moi."

