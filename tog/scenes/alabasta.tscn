[node name="CapitaineHalcion" parent="." instance=ExtResource("FerryReverse")]
position = Vector2(460.0, 2304.0)
paroles = "Remonter à Reverse Mountain ? On ne remonte pas la route des caravanes, mon mousse : on la descend en risée. Le col se rejoint par Loguetown, pas par le désert."
destination = "res://scenes/reverse_mountain.tscn"
arrivee = &"DepuisAlabasta"
libelle_traversee = "Remonter vers Reverse Mountain"

[node name="CapitaineAndage" parent="." instance=ExtResource("FerryCeleste")]
position = Vector2(330.0, 2304.0)
paroles = "Pour Skypiea, il faut mettre le cap sur le courant ascendant. Il porte les navires jusqu’à la mer Blanche. Depuis le quai de la plage des Anges, monte jusqu’au marché. Conis t’indiquera le chemin vers Shandora."
destination = "res://scenes/ile_celeste.tscn"
arrivee = &"DepuisAlabasta"
libelle_traversee = "Embarquer pour Skypiea"

[node name="CapitaineMistral" parent="." instance=ExtResource("FerryZou")]
position = Vector2(833.0, 2304.0)
paroles = "Une île qui bouge, des cloches dans les arbres et des gardiens à fourrure : Zou se gagne en tenant parole, pas en marchant vite. Embarque, le vent y est plus honnête qu'ici."
destination = "res://scenes/zou.tscn"
arrivee = &"DepuisAlabasta"
libelle_traversee = "Embarquer pour Zou"

