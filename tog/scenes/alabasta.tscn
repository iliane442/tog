position = Vector2(1421.44, 1201.28)
script = ExtResource("Recolte")
titre = "La bordière de Yuba"
description = "Une pierre plate au bord des palmiers, gravée de traits fins. L'Aiguille tourne sur elle-même : le relevé d'origine mentionne un chenal d'eau vive qui ne figure sur aucune carte vendue au port. La route de la caravane s'en souvient encore."
quete = "trm_c6_releve"
objet = ""
quantite = 1
retour_secondes = 0.0

