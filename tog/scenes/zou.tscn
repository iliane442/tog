hauteur_zone_clic = 111.0
chain_quetes = Array[String](["zou_panneaux", "zou_baies"])
nom_affiche = "Pékora du flanc"
paroles = "Bienvenue sur le flanc ! Les pancartes du duché sont des lianes d'humeur : elles bougent avec l'île. Lis-les quand même, elles disent où l'île porte. Et cueille des baies pour nos guérisseurs : la forêt de la Baleine les donne à ceux qui la respectent."

