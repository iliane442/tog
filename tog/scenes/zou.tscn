nom_affiche = "Amaru, cheffe des secours"
paroles = "Le duché de Mokomo paie ses dettes en actes, pas en promesses. Nos réserves sont coupées par un éboulis, et des traqueurs rôdent autour de la pierre rouge pour un commanditaire que même eux n'ont jamais vu. Aide-nous, et le duché te conduira là où nous n'amenons personne."

