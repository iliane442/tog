[node name="Zeff" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1280.0, 1216.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String](["trm_c4_baratie"])
nom_affiche = "Zeff"
paroles = "J'ai vu la carte entière, une nuit, entre deux vagues. Je n'ai plus jamais eu faim depuis. Et je n'ai plus jamais eu faim non plus, tu vois ? Assieds-toi, marmaille. La mer ne paie pas en pièces, elle paie en souvenirs — et j'ai déjà tout pris."

