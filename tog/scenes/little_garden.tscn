[node name="CapitaineAlize" parent="." instance=ExtResource("FerryDrum")]
position = Vector2(1620.0, 2020.0)
paroles = "Le royaume de Drum est plus au nord : des cimes, des cèdres, un château vissé sur un rocher. Salue Dalton si tu le croises, c'est le seul roi que le peuple ait vraiment eu."
destination = "res://scenes/drum.tscn"
arrivee = &"DepuisLittleGarden"
libelle_traversee = "Embarquer pour le royaume de Drum"

