[node name="makino" parent="." groups=["pnj_fushia"] instance=ExtResource("11_makino")]
position = Vector2(2899.2, 966.4)
chain_quetes = Array[String](["fushia_reperes"])
nom_affiche = "Makino"
paroles = "Prends une place en terrasse. La chaloupe du grand quai mène au navire de Shanks. Pour retrouver Dadan, prends le grand escalier au nord. Le chemin de l’ouest traverse le bois et rejoint les environs."

[node name="shankette" parent="." instance=ExtResource("15_shankette")]
position = Vector2(2464, 928)

[node name="kaya" parent="." instance=ExtResource("20_kaya")]
position = Vector2(2777.6, 982.4)
nom_affiche = "Kaya"
paroles = "Usopp jure qu'un poisson doré géant rôde autour de l'île… Il exagère un peu, mais il revient toujours sain et sauf. Sois prudente sur les flots : l'East Blue est plus calme que les rumeurs ne le disent, mais la mer reste la mer."

[node name="woop_slap" parent="." instance=ExtResource("21_woop_slap")]
position = Vector2(2560, 1155.2)
nom_affiche = "Woop Slap"
paroles = "Cinquante ans que je répare les dégâts de ce village… et toujours impossible de retenir les jeunes qui veulent voir le monde ! Va, va… mais reviens nous raconter tes bêtises, un jour ou l'autre."

[node name="coby" parent="." instance=ExtResource("22_coby")]
position = Vector2(2508.8, 1033.6)
nom_affiche = "Coby"
paroles = "Un jour, je serai un grand officier de la Marine ! Je me suis enfui du navire d'Alvida, alors un pirate de plus ou de moins, ça ne m'impressionne plus… enfin… presque plus."

[node name="zeff" parent="." instance=ExtResource("23_zeff")]
position = Vector2(2451.2, 1691.2)
nom_affiche = "Zeff"
paroles = "Trente ans de mer, moussaillon : un cuisinier qui ne sait pas se battre n'a rien à faire sur un navire de pirates. Si tu passes près du Baratie, goûte ma vinaigrette avant d'aller te faire pendre ailleurs."

[node name="yosaku" parent="." instance=ExtResource("24_yosaku")]
position = Vector2(2892.8, 1257.6)
nom_affiche = "Yosaku"
paroles = "Avec grand frère Johnny, on chasse les primes de l'East Blue ! Un Buggy ou un Kuro, ça paierait nos sakes pour un an. Tu veux faire équipe, matelot ?"

[node name="johnny" parent="." instance=ExtResource("25_johnny")]
position = Vector2(2912, 1299.2)
nom_affiche = "Johnny"
paroles = "Grand frèèèère ! Ah, c'est toi. Johnny, chasseur de primes, pour te servir. On vit de sables et de captures… et des bons conseils de Yosaku, parfois."

[node name="nojiko" parent="." instance=ExtResource("26_nojiko")]
position = Vector2(2291.2, 1046.4)
nom_affiche = "Nojiko"
paroles = "Prends une mandarine : elles viennent de la plantation de Bel-mère, à Coco. Ma soeur Nami en a plein la tête, des cartes — un jour elle cartographiera tout East Blue, tu verras."

