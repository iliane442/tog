[node name="Pell" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1696.0, 608.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String]([])
nom_affiche = "Pell"
paroles = "Depuis la chute de Crocodile, je veille sur ce qui reste de Baroque Works : leurs pillards ont fui vers les cimes. Cette île flottante au-dessus d'Alabasta recueille les blessures du désert — le sanctuaire du Faucon y soigne ses ailes. Cueille ce que la terre céleste offre, et garde ton Log Pose pointé vers le vrai nord."

