largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String]([])
nom_affiche = "Gan Fall"
paroles = "Depuis sa défaite contre Luffy, Ener s’est retranché au Sanctuaire du Tonnerre, derrière le portail de la haute-ville. J’ai vu deux groupes de sentinelles alimenter le sceau de la salle du trône. Neutralise les deux, puis rejoins Ener avant qu’il ne menace à nouveau Shandora."

