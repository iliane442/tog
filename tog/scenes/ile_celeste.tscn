[node name="CapitaineVolige" parent="." instance=ExtResource("FerryCeleste")]
position = Vector2(1760.0, 2144.0)
paroles = "Redescendre sur Alabasta ? Le Levant des Sables tient des vents contraires après midi. Pell veillera sur ton retour : aucun Roc ne traverse son regard sans y laisser une plume. Bon voyage, moussaillon des cimes."
destination = "res://scenes/alabasta.tscn"
arrivee = &"DepuisIleCeleste"
libelle_traversee = "Embarquer pour Alabasta"

