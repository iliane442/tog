[node name="CapitaineEsturgeon" parent="." instance=ExtResource("FerryLogue")]
position = Vector2(1369.6, 2080.0)
paroles = "Redescendre sur Loguetown à la marée qui suit ? Possible, mon mousse. Le courant redescend comme il monte : dans le bon chenal, et jamais sans balises."
destination = "res://scenes/loguetown.tscn"
arrivee = &"DepuisReverseMountain"
libelle_traversee = "Descendre vers Loguetown"

[node name="CapitaineSimoun" parent="." instance=ExtResource("FerryAlabasta")]
position = Vector2(1753.6, 2080.0)
paroles = "Une fois le col franchi, la mer du haut se jette dans Grand Line : ma prochaine escale sent le sable et l'épice. Alabasta. Montre ton Log Pose à la douane, pas ton assurance."
destination = "res://scenes/alabasta.tscn"
arrivee = &"DepuisReverseMountain"
libelle_traversee = "Embarquer pour Alabasta"

