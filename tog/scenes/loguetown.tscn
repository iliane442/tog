[node name="PlateformeDeRoger" type="Node2D" parent="." groups=["points_fushia"]]
position = Vector2(1504.0, 704.0)
script = ExtResource("Recolte")
titre = "La plateforme de l'Ancien"
description = "L'exécuteur de l'Ancien a tenu ici son dernier discours, il y a vingt-deux ans : « Mes trésors ? Je vous laisse les chercher. » Depuis, chaque départ se fait sous son regard de pierre. Sur le registre du cimetière voisin, une page récente a été découpée au ras de la reliure."
quete = "trm_c5b_registre"
objet = ""
quantite = 1
retour_secondes = 0.0

