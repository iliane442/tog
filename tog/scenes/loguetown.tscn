[node name="OfficierDesDeparts" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1450.0, 1520.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String](["trm_c5b_registre", "trm_c5b_comptoir", "trm_c5b_fourgant", "trm_c5b_visa"])
nom_affiche = "L'Officier des Départs"
paroles = "Chaque capitaine qui monte le courant laisse une page de son journal ici, sur la Grand-Place. C'est la règle depuis l'Ancien : une route n'existe que si quelqu'un peut la relire. Or depuis un mois, les pages partent au pilon avant d'être recopiées. Aide-moi à comprendre qui les emporte."

