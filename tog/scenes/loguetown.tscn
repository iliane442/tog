[node name="Pelage" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(2496.0, 1664.0)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 111.0
chain_quetes = Array[String]([])
nom_affiche = "Pélagie la colporteuse"
paroles = "J'achète des adieux, moi, pas des cartes. Des lettres de départ, des pages de journal, ce que les marins laissent quand ils veulent oublier. Vous partez aussi ? Alors laissez-moi compter sur mes doigts : trois îles secouées, un comptoir démantelé, un courtier perdu. Vous allez vite. C'est le seul compliment que je sais faire."

