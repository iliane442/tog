[node name="Kaya" type="Node2D" parent="." groups=["pnj_fushia"]]
position = Vector2(1504, 864)
script = ExtResource("PNJ")
largeur_zone_clic = 86.0
hauteur_zone_clic = 84.0
chain_quetes = Array[String](["trm_c3_kaya", "trm_c3_atelier", "trm_c3_kuro", "trm_c3_argent"])
nom_affiche = "Kaya"
paroles = "Chaque carte que l'on dessine est une promesse. La vôtre, on l'a faite avant vous : mon grand-père gardait déjà la montre d'un cartographe. Montez voir mes longues-vues — elles ne mentent pas, elles. Si le manoir vous fait peur après ça, c'est qu'il faut."

