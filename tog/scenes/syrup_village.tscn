nom_affiche = "Usopp"
paroles = "Pirates en vue ! Cette fois, je les ai vraiment vus près du manoir. Suis mes repères : du quai à la place, puis à la montée de chez Kaya. Les trois guetteurs ignorent que le grand capitaine Usopp les surveille !"

