nom_affiche = "Pélagie la colporteuse"
paroles = "Des cartes ? J'en achète toutes, moi, même déchirées, même fausses. Vous seriez étonné de ce que les gens jettent. Moi, je compte. On paie ce qu'on prend, on recommande ce qu'on vend. Vous ne m'avez pas vue. Personne ne me voit jamais."

